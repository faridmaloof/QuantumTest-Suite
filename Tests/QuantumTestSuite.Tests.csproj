<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    
    <!-- User Secrets support -->
    <UserSecretsId>quantum-testsuite-3f8a4b2c-9d7e-4a1f-b6c3-2e5d8f1a9b3c</UserSecretsId>
    
    <!-- Test execution configuration -->
    <ParallelizeTestCollections>false</ParallelizeTestCollections>
    <MaxParallelThreads>1</MaxParallelThreads>
  </PropertyGroup>

  <ItemGroup>
    <!-- Allure Reporting (compatible with Reqnroll) -->
    <PackageReference Include="Allure.Net.Commons" Version="2.14.1" />
    <PackageReference Include="Allure.NUnit" Version="2.14.1" />
    <PackageReference Include="Allure.Reqnroll" Version="2.14.1" />
    
    <!-- Dependency Injection -->
    <PackageReference Include="Autofac" Version="9.0.0" />
    
    <!-- Test Data Generation -->
    <PackageReference Include="Bogus" Version="35.6.5" />
    
    <!-- Code Coverage -->
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    
    <!-- Data Access & CSV -->
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    
    <!-- Environment Configuration -->
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.1" />
    
    <!-- Test Framework & SDK -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    
    <!-- Playwright (Browser Automation) -->
    <PackageReference Include="Microsoft.Playwright" Version="1.57.0" />
    <PackageReference Include="Microsoft.Playwright.NUnit" Version="1.57.0" />
    
    <!-- Mocking -->
    <PackageReference Include="Moq" Version="4.20.72" />
    
    <!-- NUnit Test Framework -->
    <PackageReference Include="NUnit" Version="4.4.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.11.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.0.1" />
    
    <!-- Reqnroll BDD Framework (formerly SpecFlow - opensource fork) -->
    <PackageReference Include="Reqnroll" Version="3.3.0" />
    <PackageReference Include="Reqnroll.Autofac" Version="3.3.0" />
    <PackageReference Include="Reqnroll.NUnit" Version="3.3.0" />
    <PackageReference Include="Reqnroll.Tools.MsBuild.Generation" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.*.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Data\ExternalData\**\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="allureConfig.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="reqnroll.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Reports\**\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

</Project>
