{
  "Env": "production",
  "Playwright": {
    "Headless": true,
    "Browser": "chromium",
    "BaseUrl": "https://www.saucedemo.com/",
    "SlowMo": 0,
    "VideoEnabled": false,
    "ScreenshotOptions": {
      "BeforeStep": false,
      "AfterStep": false,
      "OnFailure": true
    }
  },
  "Apis": {
    "HttpBin": "https://httpbin.org",
    "RestfulBooker": "https://restful-booker.herokuapp.com",
    "GitHub": "https://api.github.com",
    "GhUsersSearchUi": "https://gh-users-search.netlify.app/"
  },
  "Users": {
    "SauceDemo": {
      "Username": "",
      "Password": ""
    }
  },
  "Allure": {
    "Directory": "Reports/AllureResults",
    "CleanupCycle": 1
  }
}
