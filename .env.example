# ============================================================================
# Quantum Test Suite - Environment Configuration Template
# ============================================================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env for local development
# 2. Copy to .env.{environment} for specific environments (e.g., .env.qa, .env.staging)
# 3. Update values as needed for your environment
# 4. NEVER commit .env files with real credentials to git
#
# PRECEDENCE (highest to lowest):
# 1. System Environment Variables (set in CI/CD or terminal)
# 2. .env.{TEST_ENVIRONMENT} file (e.g., .env.qa)
# 3. .env file
# 4. Default values in ConfigManager
#
# ============================================================================

# ============================================================================
# ENVIRONMENT IDENTIFIER
# ============================================================================
# Options: local, dev, qa, staging, production
TEST_ENVIRONMENT=local

# ============================================================================
# PLAYWRIGHT SETTINGS
# ============================================================================

# Browser Configuration
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_BASE_URL=https://www.saucedemo.com/
PLAYWRIGHT_SLOWMO=0

# Video Recording (true to record full scenario execution)
PLAYWRIGHT_VIDEO_ENABLED=false

# Screenshot Capture Configuration
# - BeforeStep: Capture screenshot before each test step (high volume)
# - AfterStep: Capture screenshot after each test step (high volume)
# - OnFailure: Capture screenshot only when a test fails (recommended for CI/CD)
SCREENSHOT_BEFORE_STEP=false
SCREENSHOT_AFTER_STEP=false
SCREENSHOT_ON_FAILURE=true

# ============================================================================
# API ENDPOINTS
# ============================================================================

API_HTTPBIN=https://httpbin.org
API_RESTFUL_BOOKER=https://restful-booker.herokuapp.com
API_GITHUB=https://api.github.com
API_GH_USERS_SEARCH_UI=https://gh-users-search.netlify.app/

# ============================================================================
# TEST CREDENTIALS
# ============================================================================

# SauceDemo Application
SAUCEDEMO_USERNAME=standard_user
SAUCEDEMO_PASSWORD=secret_sauce

# ============================================================================
# TEST EXECUTION CONTROL
# ============================================================================

# Enable/Disable UI test execution (true/false)
RUN_UI_TESTS=false

# ============================================================================
# ALLURE REPORTING
# ============================================================================

ALLURE_RESULTS_DIRECTORY=Reports/AllureResults
ALLURE_CLEANUP_CYCLE=1

# ============================================================================
# CI/CD SPECIFIC (Optional - usually set by pipeline)
# ============================================================================

# DOTNET_ENVIRONMENT=Production
# BUILD_ID=12345
# BUILD_NUMBER=1.0.0
